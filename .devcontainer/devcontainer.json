{
  "name": "C++ Docker Dev",
  "build": {
    "dockerfile": "../Dockerfile",
    "options": [
      "--tag", "marketreplay-dev:latest"
    ]
  },
  "customizations": {
    "vscode": {
      "settings": {
        "remote.autoForwardPorts": false
      },
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "matepek.vscode-catch2-test-adapter"
      ]
    }
  }
}